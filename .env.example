# Safe local default. No API key is required for mock mode.
AGENTGATE_LLM_PROVIDER=mock
AGENTGATE_LLM_BASE_URL=
AGENTGATE_LLM_API_KEY=
AGENTGATE_LLM_MODEL=mock-operations-agent
AGENTGATE_API_PORT=8000
AGENTGATE_WEB_PORT=5173

# For live mode, set these only in the untracked .env file after rotating the key:
# AGENTGATE_LLM_PROVIDER=openai_compatible
# AGENTGATE_LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
# AGENTGATE_LLM_API_KEY=your_api_key_here
# AGENTGATE_LLM_MODEL=your-model-name
